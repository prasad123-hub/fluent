# ───────────────────────────── Fluent environment ─────────────────────────────
# Copy to `.env` at the repo root. `apps/web` and `apps/agent` both read it.
# Never commit `.env`.

# ── Database (Postgres). docker-compose default shown. Production: Neon / Vercel Postgres URL.
DATABASE_URL=postgresql://fluent:fluent@localhost:5432/fluent

# ── Single-owner login (Auth.js credentials provider). No sign-up exists.
# Generate the hash with:  pnpm --filter @fluent/web hash-password "your password"
OWNER_EMAIL=you@example.com
# bcrypt hashes contain `$`; escape each one as `\$` in .env files (Next expands `$VAR`). The hash script prints it escaped.
# On hosting dashboards (Vercel, Fly) paste the raw hash — they do not expand variables.
OWNER_PASSWORD_HASH=\$2a\$12\$replace-me-with-a-bcrypt-hash
OWNER_NAME=Prasad
# 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me
# Public URL of the web app (used by Auth.js and OG metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LiveKit (Cloud project or self-hosted `docker compose --profile livekit`)
# Self-hosted dev server values: ws://localhost:7880 / devkey / secret
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the agent worker registers with (explicit dispatch). Keep in sync with the agent.
LIVEKIT_AGENT_NAME=fluent-agent
# Shared secret for the LiveKit webhook endpoint is the API key/secret above (JWT-signed).

# ── Model providers (agent worker)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Optional alternatives
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# Which provider the conversation LLM uses: openai | anthropic
FLUENT_LLM_PROVIDER=openai
FLUENT_LLM_MODEL=gpt-4.1
# Which TTS provider: cartesia | elevenlabs | openai
FLUENT_TTS_PROVIDER=cartesia
# STT: deepgram | openai  (openai = Whisper/gpt-4o-transcribe fallback)
FLUENT_STT_PROVIDER=deepgram
# Analysis LLM model (structured JSON); defaults to the conversation provider
FLUENT_ANALYSIS_MODEL=gpt-4.1
# Deterministic scripted LLM for key-free local verification (1 = on). Never set in production.
FLUENT_FAKE_LLM=0
# Turn detection: model (LiveKit turn detector, default) | vad | stt. Use `vad` offline.
FLUENT_TURN_DETECTOR=model
# Dev only: pin the load the worker reports to LiveKit (0–1). Leave unset in production.
# FLUENT_FIXED_LOAD=0
# Optional per-preset voice overrides, e.g. FLUENT_VOICE_PRIYA_CARTESIA=<cartesia voice id>
# FLUENT_VOICE_ARJUN_ELEVENLABS=<elevenlabs voice id>

# ── Cost & safety caps
FLUENT_MAX_SESSION_MINUTES=30
FLUENT_MAX_DAILY_MINUTES=120

# ── Recordings via LiveKit Egress → S3-compatible storage (optional; MinIO from docker-compose shown)
RECORDINGS_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fluent-recordings
S3_ACCESS_KEY=fluent
S3_SECRET_KEY=fluentfluent
S3_FORCE_PATH_STYLE=true

# ── Optional email reminders (Resend). Leave empty to disable.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Fluent <reminders@example.com>

# ── Observability
LOG_LEVEL=info

# ── Developer-only toggles
# Expose the /design component showcase in production builds (it is always available in `pnpm dev`).
# FLUENT_ENABLE_DESIGN_PAGE=1
# Skip boot-time env validation (used by the test runner only).
# FLUENT_SKIP_ENV_VALIDATION=1
